# Environment Configuration
# Note: All protected keys, database credentials, and API secrets must remain server-side only.
# Never expose secret keys via VITE_ variables or client-side define blocks.
APP_URL="MY_APP_URL"

# Founder Admin Intake Key (protects GET/PATCH /api/admin/pilot-requests via x-admin-key header)
# Defaults to "operationalyst-local-dev-key" in local demonstration environments if unset.
# ADMIN_ACCESS_KEY=

# Optional Webhook URL for instant lead capture notifications (Slack / Discord / Make / Zapier)
# 100% optional — fails silently if unset.
# LEAD_NOTIFICATION_WEBHOOK_URL=

# Optional Web3Forms Public Access Key for 1-click email notifications on Pilot Audit submit
# 100% optional — server inbox (/api/pilot-requests) always captures leads even if unset.
# VITE_WEB3FORMS_KEY=


